{
  "name": "svans-holographic-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental SVANS holographic Windows desktop HUD.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron electron/main.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer/app.js",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vansantplatform.svans.holographic",
    "productName": "SVANS Holographic Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
