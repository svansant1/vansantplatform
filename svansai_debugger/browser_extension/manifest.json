{
  "manifest_version": 3,
  "name": "SVANSAI Debugger Site Bridge",
  "description": "Opt-in bridge for sharing current browser tabs with the SVANSAI Debugger.",
  "version": "2.0.0",
  "permissions": ["tabs", "storage", "alarms", "webNavigation", "webRequest"],
  "optional_permissions": ["debugger"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SVANSAI Site Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["diagnostic-rules.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-observer.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
